# Client: Clerk Dashboard > API Keys. This publishable key is browser-visible.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Server: Clerk Dashboard > API Keys. Never prefix secrets with VITE_.
CLERK_SECRET_KEY=your_clerk_secret_key

# PostgreSQL / Neon
# Neon Dashboard > Connect. Use the pooled connection string here.
DATABASE_URL=your_postgres_connection_url
# Neon Dashboard > Connect. Use the direct connection string for migrations.
# Keep the schema parameter so migrations stay isolated from legacy public tables.
DIRECT_URL=your_direct_postgres_connection_url?schema=rentreel

# Cloudinary Dashboard > API Keys (optional; required together for uploads).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server configuration
NODE_ENV=development
PORT=4000
# Exact browser origin; local Vite default.
CLIENT_URL=http://localhost:5173

# Optional: Clerk Dashboard > Webhooks > signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret
