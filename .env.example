# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/database?schema=rentreel

# Server configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Public frontend API origin. Leave empty locally to use the Vite /api proxy.
VITE_API_URL=
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
# Refresh tokens are opaque and database-hashed; no JWT refresh secret is used.
JWT_REFRESH_SECRET=not_used_opaque_refresh_tokens
OTP_HMAC_SECRET=replace_with_a_different_32_character_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=RentReel <noreply@example.com>

# Optional Cloudinary upload integration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
